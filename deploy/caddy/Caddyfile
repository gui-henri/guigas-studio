:80 {
	# RPC + health goes to the Go API (Connect handlers live under /app.studio.v1/*).
	handle /app.studio.v1/* {
		reverse_proxy api:8080 {
			flush_interval -1
		}
	}

	# SSE must stream without buffering (D-03).
	handle /api/events* {
		reverse_proxy api:8080 {
			flush_interval -1
		}
	}

	handle /healthz {
		reverse_proxy api:8080
	}

	# Everything else: SPA placeholder until the frontend build is served from here.
	handle {
		respond "Guigas Studio" 200
	}
}
