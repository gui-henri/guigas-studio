# Guigas Studio — variáveis de ambiente
# Copie para `.env` (nunca commitado) e preencha os valores reais.

# --- Conta única do dashboard (D-04) ---
# Usuário do login.
STUDIO_USERNAME=gui
# Hash argon2id encoded da senha (formato $argon2id$...). Gerador: tarefa S0-07.
STUDIO_PASSWORD_HASH=

# --- Segredos ---
# Segredo HS256 dos JWT de sessão. Gere com: openssl rand -base64 48
JWT_SECRET=
# Token Bearer próprio do runner local (PAT). Gere com: openssl rand -hex 32
RUNNER_TOKEN=

# --- Serviços externos ---
# Credencial da Gemini API (transcrição, legendas EN, copy mecânica).
GEMINI_API_KEY=
# Variante do modelo Gemini (default: gemini-2.5-flash-lite na S3-01).
GEMINI_MODEL=
# Timeout por request em segundos (default 60).
GEMINI_TIMEOUT=60
# Modelo só para geração de roteiros (default: GEMINI_MODEL).
GEMINI_SCRIPT_MODEL=
# Timeout só para geração de roteiros em segundos (default: GEMINI_TIMEOUT, sugerido 120).
GEMINI_SCRIPT_TIMEOUT=120
# Tentativas do loop gerar->validar antes de desistir (default 3).
SCRIPTGEN_MAX_ATTEMPTS=3
# URL do feed RSS do blog vigiado pelo watcher (S0-16).
RSS_URL=
# Intervalo entre polls do watcher (duração Go, ex.: 30m).
RSS_POLL_INTERVAL=30m

# --- Runtime do Studio ---
# Diretório do workspace de vídeos dentro do container (volume studio_data).
DATA_DIR=/data

# --- Postgres (D-02) ---
POSTGRES_USER=studio
POSTGRES_PASSWORD=
POSTGRES_DB=studio
# Dentro da rede compose o host é o nome do serviço; localhost só vale fora dos containers.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- Objetos S3 (binários: audio/renders/assets) ---
# Desligado por padrão: binários ficam em DATA_DIR. Ligue apontando direto
# para o Cloudflare R2 (sem MinIO). Texto (script.json/timelines) sempre
# fica no disco+git.
S3_ENABLED=false
# R2: https://<accountid>.r2.cloudflarestorage.com (ver dashboard Cloudflare).
S3_ENDPOINT=
# R2 exige "auto".
S3_REGION=auto
S3_BUCKET=studio-artifacts
# Token da API R2 (Access Key ID + Secret).
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Domínio público/custom opcional para GETs (default: ENDPOINT).
S3_PUBLIC_URL=
# Sempre false na R2 (virtual-hosted style).
S3_FORCE_PATH_STYLE=false
