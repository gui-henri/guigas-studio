# Guigas Studio — variáveis de ambiente
# Copie para `.env` (nunca commitado) e preencha os valores reais.

# --- Conta única do dashboard (D-04) ---
# Usuário do login.
STUDIO_USERNAME=gui
# Hash argon2id encoded da senha (formato $argon2id$...). Gerador: tarefa S0-07.
STUDIO_PASSWORD_HASH=

# --- Segredos ---
# Segredo HS256 dos JWT de sessão. Gere com: openssl rand -base64 48
JWT_SECRET=
# Token Bearer próprio do runner local (PAT). Gere com: openssl rand -hex 32
RUNNER_TOKEN=

# --- Serviços externos ---
# Credencial da Gemini API (transcrição, legendas EN, copy mecânica).
GEMINI_API_KEY=
# URL do feed RSS do blog vigiado pelo watcher (S0-16).
RSS_URL=
# Intervalo entre polls do watcher (duração Go, ex.: 30m).
RSS_POLL_INTERVAL=30m

# --- Runtime do Studio ---
# Diretório do workspace de vídeos dentro do container (volume studio_data).
DATA_DIR=/data

# --- Postgres (D-02) ---
POSTGRES_USER=studio
POSTGRES_PASSWORD=
POSTGRES_DB=studio
# Dentro da rede compose o host é o nome do serviço; localhost só vale fora dos containers.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
